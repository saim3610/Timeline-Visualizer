    <!-- Phase 9: Privacy screen -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_local_title">Local processing</string>
    <string name="privacy_local_text">Everything happens on this device. Your timeline is parsed locally and videos are rendered locally with the device\u2019s own encoder. There is no account, no sign-in, and no server processing your data.</string>
    <string name="privacy_timeline_title">Timeline data</string>
    <string name="privacy_timeline_text">The app reads only the Timeline.json file you choose through the system file picker. The original file is never modified, moved, or deleted by the app \u2014 it stays exactly where you picked it.</string>
    <string name="privacy_location_title">Location data</string>
    <string name="privacy_location_text">The app visualizes the historical coordinates contained in your imported timeline. It does not track your live location, does not run in the background to collect locations, and does not request location permission.</string>
    <string name="privacy_geonames_title">Place names (GeoNames)</string>
    <string name="privacy_geonames_text">City names are resolved on-device from a bundled GeoNames dataset (CC-BY 4.0). Coordinates are never sent to a geocoding service.</string>
    <string name="privacy_network_title">Network use</string>
    <string name="privacy_network_text">The only network use is downloading map tiles for the areas you view or render (OpenStreetMap/CARTO, Esri, or OpenTopoMap depending on the map style). Your timeline data is never uploaded.</string>
    <string name="privacy_videos_title">Video files</string>
    <string name="privacy_videos_text">Generated videos are saved with Android\u2019s MediaStore into Movies/Timeline Visualizer on this device. The app manages only the videos it created itself; it never scans or deletes your other files.</string>
    <string name="privacy_analytics_title">Analytics &amp; advertising</string>
    <string name="privacy_analytics_text">No analytics SDK and no advertising SDK are included. The app does not measure your behavior or show ads.</string>
    <string name="privacy_cloud_title">Cloud upload</string>
    <string name="privacy_cloud_text">Imported timeline data and generated videos are not uploaded to any cloud backend by the app. Sharing only happens when you explicitly tap Share.</string>

